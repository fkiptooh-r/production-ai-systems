# Copy this file to .env and fill in real values. .env is gitignored, never commit it.
# Set a monthly spending limit on every provider dashboard before using a key.

# --- LLM providers (you only need one to start) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama (free, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# --- Database (01-hybrid-rag onwards) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_systems

# --- Tracing (02-llm-tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Voice (05-voice-agent) ---
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
