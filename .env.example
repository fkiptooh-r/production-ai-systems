# Copy this file to .env and fill in real values. .env is gitignored, never commit it.
# Set a monthly spending limit on every provider dashboard before using a key.

# --- LLM providers (you only need one to start) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama (free, no key needed)
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and adds seconds of delay.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Database (Docker, see 00-foundations/docker-compose.yml) ---
# Port 5433, because a Windows Postgres service already uses 5432.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ai_systems

# --- Tracing (02-llm-tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000

# --- Voice (05-voice-agent) ---
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
